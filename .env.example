# ── Base de datos (PostgreSQL) ──
# Local (docker-compose): el valor ya está en docker-compose.yml.
# Producción: cadena de conexión de tu proveedor (Neon, Supabase, Railway, RDS...).
DATABASE_URL="postgresql://ferremax:ferremax@localhost:5432/ferremax"

# ── Secretos JWT (¡cambiar en producción!) ──
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-largo"

# ── White-Label / resolución de tenant ──
ROOT_DOMAIN="ferremax.app"   # <slug>.ferremax.app

# ── Servidor ──
PORT="4000"
PUBLIC_URL="http://localhost:4000"   # base para servir logos en modo disco local

# ── Almacenamiento de logos/assets (White-Label) ──
# Sin estas variables se usa disco local (/uploads). Para producción → S3/CDN:
#   npm i @aws-sdk/client-s3
# S3_BUCKET="ferremax-assets"
# AWS_REGION="us-east-1"
# CDN_BASE_URL="https://cdn.tudominio.com"   # opcional (CloudFront)

# ── Frontend (Vite) ──
# URL pública del API para el panel admin y el storefront.
VITE_API_URL="http://localhost:4000/auth"
VITE_STOREFRONT_API="http://localhost:4000/storefront"
